# ==========================================
# Smart Society Connect
# Environment Configuration Example
# ==========================================
# Copy this file to .env for local Docker usage.
# Never commit the real .env file or real credentials.

# MySQL - local Docker defaults
MYSQL_DATABASE=smart_society_connect_db
MYSQL_ROOT_PASSWORD=change-me
MYSQL_USER=smartuser
MYSQL_PASSWORD=change-me

# Spring Boot database configuration
# For local non-Docker backend:
DB_URL=jdbc:mysql://localhost:3306/smart_society_connect_db
DB_USERNAME=root
DB_PASSWORD=change-me
# For Docker Compose, use the MySQL service hostname instead of localhost if required.

# Application Security
APP_JWT_SECRET=replace-with-a-secure-random-32-plus-character-secret
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JPA
JPA_DDL_AUTO=validate

# Email / OTP - Resend HTTP API
# Create your own key in Resend and never commit the real value.
RESEND_API_KEY=re_your_resend_api_key
# onboarding@resend.dev is suitable only for Resend's limited testing flow.
# For normal recipients, configure a sender/domain verified in your own Resend account.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Optional legacy SMTP configuration (not required by the current Resend EmailServiceImpl)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Razorpay - optional payment integration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
